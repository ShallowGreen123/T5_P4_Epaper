menu "HDMI LVGL Demo Configuration"

    choice HDMI_LVGL_DEMO
        prompt "Select LVGL demo"
        default HDMI_LVGL_DEMO_BENCHMARK
        help
            Select the LVGL demo that starts automatically after HDMI display
            initialization.

        config HDMI_LVGL_DEMO_BENCHMARK
            bool "Benchmark"
            select LV_USE_DEMO_BENCHMARK
            help
                Run LVGL's benchmark demo to measure rendering performance.

        config HDMI_LVGL_DEMO_STRESS
            bool "Stress"
            select LV_USE_DEMO_STRESS
            help
                Run LVGL's stress demo to exercise object creation and drawing.

        config HDMI_LVGL_DEMO_WIDGETS
            bool "Widgets"
            select LV_USE_DEMO_WIDGETS
            select LV_DEMO_WIDGETS_SLIDESHOW
            help
                Run LVGL's widgets demo. Slideshow mode is enabled so the demo
                remains useful without touch, keyboard, or encoder input.
    endchoice

endmenu
