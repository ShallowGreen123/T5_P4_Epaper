CONFIG_IDF_TARGET="esp32p4"
CONFIG_IDF_TARGET_ESP32P4=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_BOOTLOADER_LOG_COLORS=y
CONFIG_BOOTLOADER_LOG_TIMESTAMP_SOURCE_CPU_TICKS=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_EPUB_READER_ROTATION=270
CONFIG_FREERTOS_HZ=1000
CONFIG_EPUB_READER_TASK_STACK_SIZE=65536
CONFIG_EPUB_READER_BODY_LINE_GAP=2
CONFIG_EPUB_READER_PARAGRAPH_GAP=6
CONFIG_EPUB_READER_SPACE_WIDTH_PERCENT=0
CONFIG_EPUB_READER_INTER_WORD_TIGHTEN_PX=2
CONFIG_EPUB_READER_JUSTIFY_MAX_SPACE_PERCENT=20
CONFIG_EPUB_READER_ENGLISH_FIRST_LINE_INDENT=28

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_FATFS_LFN_HEAP=y
