menu "Factory Example"

config FACTORY_TOUCH_I2C_ADDR
    hex "GT911 7-bit I2C address"
    default 0x5D
    range 0x00 0x7F

config FACTORY_TOUCH_I2C_SDA
    int "Shared I2C SDA GPIO"
    default 7
    range 0 54

config FACTORY_TOUCH_I2C_SCL
    int "Shared I2C SCL GPIO"
    default 8
    range 0 54

config FACTORY_TOUCH_INT_GPIO
    int "Touch interrupt GPIO"
    default 3
    range 0 54

config FACTORY_DISPLAY_TEST_LOCAL_REFRESH_MS
    int "Display test local refresh period (ms)"
    default 1200
    range 100 60000

config FACTORY_DISPLAY_TEST_FULL_REFRESH_MS
    int "Display test automatic full refresh period (ms)"
    default 30000
    range 1000 600000

config FACTORY_BATTERY_BQ25896_ADDR
    hex "BQ25896 7-bit I2C address"
    default 0x6B
    range 0x00 0x7F

config FACTORY_BATTERY_BQ27220_ADDR
    hex "BQ27220 7-bit I2C address"
    default 0x55
    range 0x00 0x7F

config FACTORY_BATTERY_REFRESH_MS
    int "Battery page refresh period (ms)"
    default 2000
    range 500 60000

config FACTORY_BATTERY_CAPACITY_MAH
    int "Battery design capacity (mAh)"
    default 1100
    range 100 5000

config FACTORY_BATTERY_CHARGE_CURRENT_MA
    int "Battery fast charge current (mA)"
    default 512
    range 0 1000

config FACTORY_BATTERY_PRECHARGE_CURRENT_MA
    int "Battery precharge current (mA)"
    default 64
    range 0 1000

config FACTORY_BATTERY_TERM_CURRENT_MA
    int "Battery termination current (mA)"
    default 64
    range 0 1000

config FACTORY_BATTERY_CHARGE_VOLTAGE_MV
    int "Battery charge voltage (mV)"
    default 4208
    range 3000 4600

config FACTORY_BATTERY_TERM_VOLTAGE_DELTA_MV
    int "Battery charge termination voltage delta (mV)"
    default 100
    range 0 1000

config FACTORY_BATTERY_SYSTEM_MIN_MV
    int "Battery minimum system voltage (mV)"
    default 3300
    range 2500 3700

config FACTORY_BATTERY_CURRENT_THRESHOLD_MA
    int "Battery state threshold current (mA)"
    default 20
    range 0 500

config FACTORY_BATTERY_LOW_VOLTAGE_MV
    int "Battery low-voltage protection threshold (mV)"
    default 3300
    range 2500 4000

config FACTORY_BATTERY_LOW_POWER_COUNTDOWN_SEC
    int "Battery low-voltage shutdown countdown (s)"
    default 20
    range 1 120

config FACTORY_BATTERY_LOW_POWER_POLL_MS
    int "Battery low-voltage monitor polling period (ms)"
    default 250
    range 100 5000

config FACTORY_BOOT_TOUCH_DIAGNOSTICS
    bool "Boot directly into the touch diagnostics page"
    default n

config FACTORY_AUDIO_SAMPLE_RATE
    int "Audio showcase sample rate (Hz)"
    default 16000
    range 8000 48000
    help
        The ES8311 showcase uses a 256x MCLK coefficient table for common rates.
        Keep the default 16000 Hz for factory microphone and loopback tests.

config FACTORY_AUDIO_RECORD_SECONDS
    int "Audio showcase recording length (s)"
    default 3
    range 1 10

config FACTORY_AUDIO_VOLUME_PERCENT
    int "Audio showcase speaker volume (%)"
    default 70
    range 0 100

config FACTORY_AUDIO_MIC_GAIN_DB
    int "Audio showcase microphone gain (dB)"
    default 30
    range 0 42
    help
        Rounded to the nearest ES8311 6 dB gain step.

config FACTORY_AUDIO_MIC_PASS_PEAK_PERCENT
    int "Audio showcase microphone PASS peak threshold (%)"
    default 4
    range 1 100

config FACTORY_AUDIO_MONITOR_PERIOD_MS
    int "Audio showcase monitor polling period (ms)"
    default 120
    range 20 1000

config FACTORY_AUDIO_TASK_STACK_SIZE
    int "Audio showcase task stack size"
    default 6144
    range 4096 16384

endmenu
