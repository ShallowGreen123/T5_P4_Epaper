menu "Factory Example"


config FACTORY_BOOT_BUTTON_GPIO
    int "BOOT button GPIO for full refresh (-1 disables)"
    default 35
    range -1 54
    help
        Pressing the BOOT button requests one e-paper full refresh. Keep the
        default GPIO35 for the ESP32-P4 BOOT key. The button is pulled up and
        active low.

menu "Display"

config FACTORY_DISPLAY_TEST_LOCAL_REFRESH_MS
    int "Display test local refresh period (ms)"
    default 1200
    range 100 60000

config FACTORY_DISPLAY_TEST_FULL_REFRESH_MS
    int "Display test automatic full refresh period (ms)"
    default 30000
    range 1000 600000
    
endmenu

menu "Touch"

config FACTORY_TOUCH_I2C_ADDR
    hex "GT911 7-bit I2C address"
    default 0x5D
    range 0x00 0x7F

config FACTORY_TOUCH_I2C_SDA
    int "Shared I2C SDA GPIO"
    default 7
    range 0 54

config FACTORY_TOUCH_I2C_SCL
    int "Shared I2C SCL GPIO"
    default 8
    range 0 54

config FACTORY_TOUCH_INT_GPIO
    int "Touch interrupt GPIO"
    default 3
    range 0 54

endmenu

menu "Battery"

config FACTORY_BATTERY_BQ25896_ADDR
    hex "BQ25896 7-bit I2C address"
    default 0x6B
    range 0x00 0x7F

config FACTORY_BATTERY_BQ27220_ADDR
    hex "BQ27220 7-bit I2C address"
    default 0x55
    range 0x00 0x7F

config FACTORY_BATTERY_REFRESH_MS
    int "Battery page refresh period (ms)"
    default 2000
    range 500 60000

config FACTORY_BATTERY_CAPACITY_MAH
    int "Battery design capacity (mAh)"
    default 1100
    range 100 5000

config FACTORY_BATTERY_CHARGE_CURRENT_MA
    int "Battery fast charge current (mA)"
    default 512
    range 0 1000

config FACTORY_BATTERY_PRECHARGE_CURRENT_MA
    int "Battery precharge current (mA)"
    default 64
    range 0 1000

config FACTORY_BATTERY_TERM_CURRENT_MA
    int "Battery termination current (mA)"
    default 64
    range 0 1000

config FACTORY_BATTERY_CHARGE_VOLTAGE_MV
    int "Battery charge voltage (mV)"
    default 4208
    range 3000 4600

config FACTORY_BATTERY_TERM_VOLTAGE_DELTA_MV
    int "Battery charge termination voltage delta (mV)"
    default 100
    range 0 1000

config FACTORY_BATTERY_SYSTEM_MIN_MV
    int "Battery minimum system voltage (mV)"
    default 3300
    range 2500 3700

config FACTORY_BATTERY_CURRENT_THRESHOLD_MA
    int "Battery state threshold current (mA)"
    default 20
    range 0 500

config FACTORY_BATTERY_LOW_VOLTAGE_MV
    int "Battery low-voltage protection threshold (mV)"
    default 3300
    range 2500 4000

config FACTORY_BATTERY_LOW_POWER_COUNTDOWN_SEC
    int "Battery low-voltage shutdown countdown (s)"
    default 20
    range 1 120

config FACTORY_BATTERY_LOW_POWER_POLL_MS
    int "Battery low-voltage monitor polling period (ms)"
    default 250
    range 100 5000

endmenu

menu "Camera"

config FACTORY_CAMERA_ENABLE
    bool "Enable instant camera page"
    default y
    select ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE
    select ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE
    select ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER
    select CAMERA_XCLK_USE_ESP_CLOCK_ROUTER

choice FACTORY_CAMERA_SENSOR
    prompt "Camera sensor"
    depends on FACTORY_CAMERA_ENABLE
    default FACTORY_CAMERA_SENSOR_OV2710

    config FACTORY_CAMERA_SENSOR_OV2710
        bool "OV2710"
        select CAMERA_OV2710
        select CAMERA_OV2710_MIPI_RAW10_1280X720_25FPS

    config FACTORY_CAMERA_SENSOR_SC2336
        bool "SC2336"
        select CAMERA_SC2336
        select CAMERA_SC2336_MIPI_RAW8_1280X720_30FPS

    config FACTORY_CAMERA_SENSOR_OV5645
        bool "OV5645"
        select CAMERA_OV5645
        select CAMERA_OV5645_MIPI_YUV422_1280X960_30FPS
endchoice

config FACTORY_CAMERA_I2C_FREQ_HZ
    int "Camera SCCB/I2C frequency (Hz)"
    depends on FACTORY_CAMERA_ENABLE
    default 100000
    range 10000 400000

config FACTORY_CAMERA_ENABLE_POWER
    bool "Enable camera rails through SGM38121"
    depends on FACTORY_CAMERA_ENABLE
    default y

config FACTORY_CAMERA_DVDD1_MV
    int "SGM38121 DVDD1 target voltage (mV, 0 disables)"
    depends on FACTORY_CAMERA_ENABLE_POWER
    default 0
    range 0 1504

config FACTORY_CAMERA_DVDD2_MV
    int "SGM38121 DVDD2 target voltage (mV, 0 disables)"
    depends on FACTORY_CAMERA_ENABLE_POWER
    default 0
    range 0 1504

config FACTORY_CAMERA_AVDD1_MV
    int "SGM38121 AVDD1 target voltage (mV)"
    depends on FACTORY_CAMERA_ENABLE_POWER
    default 1800
    range 1504 3424

config FACTORY_CAMERA_AVDD2_MV
    int "SGM38121 AVDD2 target voltage (mV)"
    depends on FACTORY_CAMERA_ENABLE_POWER
    default 2800
    range 1504 3424

config FACTORY_CAMERA_RESET_GPIO
    int "Camera RESET GPIO (-1 disables)"
    depends on FACTORY_CAMERA_ENABLE
    default -1
    range -1 54

config FACTORY_CAMERA_PWDN_GPIO
    int "Camera PWDN GPIO (-1 disables)"
    depends on FACTORY_CAMERA_ENABLE
    default -1
    range -1 54

config FACTORY_CAMERA_XCLK_GPIO
    int "Camera XCLK GPIO (-1 disables)"
    depends on FACTORY_CAMERA_ENABLE
    default -1
    range -1 54

config FACTORY_CAMERA_XCLK_FREQ_HZ
    int "Camera XCLK frequency (Hz)"
    depends on FACTORY_CAMERA_ENABLE
    default 24000000
    range 1000000 40000000

config FACTORY_CAMERA_CAPTURE_WIDTH
    int "Requested capture width"
    depends on FACTORY_CAMERA_ENABLE
    default 1280
    range 160 2592

config FACTORY_CAMERA_CAPTURE_HEIGHT
    int "Requested capture height"
    depends on FACTORY_CAMERA_ENABLE
    default 720
    range 120 1944

config FACTORY_CAMERA_OUTPUT_WIDTH
    int "Preview output width"
    depends on FACTORY_CAMERA_ENABLE
    default 640
    range 160 1440

config FACTORY_CAMERA_OUTPUT_HEIGHT
    int "Preview output height"
    depends on FACTORY_CAMERA_ENABLE
    default 360
    range 120 720

config FACTORY_CAMERA_VIDEO_BUFFER_COUNT
    int "V4L2 video buffer count"
    depends on FACTORY_CAMERA_ENABLE
    default 3
    range 2 4

config FACTORY_CAMERA_TASK_STACK_SIZE
    int "Camera capture task stack size"
    depends on FACTORY_CAMERA_ENABLE
    default 8192
    range 6144 16384

endmenu

menu "Audio"

config FACTORY_AUDIO_SAMPLE_RATE
    int "Audio showcase sample rate (Hz)"
    default 16000
    range 8000 48000
    help
        The ES8311 showcase uses a 256x MCLK coefficient table for common rates.
        Keep the default 16000 Hz for factory microphone and loopback tests.

config FACTORY_AUDIO_RECORD_SECONDS
    int "Audio showcase recording length (s)"
    default 3
    range 1 10

config FACTORY_AUDIO_VOLUME_PERCENT
    int "Audio showcase speaker volume (%)"
    default 70
    range 0 100

config FACTORY_AUDIO_LOOPBACK_VOLUME_PERCENT
    int "Audio showcase safe loopback speaker volume (%)"
    default 65
    range 0 100
    help
        Live mic-to-speaker loopback can create acoustic feedback when the
        microphone is close to the speaker. Keep this low for factory safety.

config FACTORY_AUDIO_LOOPBACK_GAIN_PERCENT
    int "Audio showcase safe loopback digital gain (%)"
    default 18
    range 0 100
    help
        Digital attenuation applied before writing microphone samples back to
        the speaker during loopback.

config FACTORY_AUDIO_LOOPBACK_LIMIT_PERCENT
    int "Audio showcase safe loopback output limiter (%)"
    default 18
    range 1 50
    help
        Maximum absolute PCM output level during loopback, as a percentage of
        full scale.

config FACTORY_AUDIO_MIC_GAIN_DB
    int "Audio showcase microphone gain (dB)"
    default 30
    range 0 42
    help
        Rounded to the nearest ES8311 6 dB gain step.

config FACTORY_AUDIO_MIC_PASS_PEAK_PERCENT
    int "Audio showcase microphone PASS peak threshold (%)"
    default 4
    range 1 100

config FACTORY_AUDIO_MONITOR_PERIOD_MS
    int "Audio showcase monitor polling period (ms)"
    default 120
    range 20 1000

config FACTORY_AUDIO_TASK_STACK_SIZE
    int "Audio showcase task stack size"
    default 6144
    range 4096 16384

endmenu

endmenu
