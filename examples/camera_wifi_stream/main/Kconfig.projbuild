menu "Camera WiFi Stream Configuration"

config CAMERA_WIFI_STREAM_WIFI_SSID
    string "WiFi SSID"
    default ""

config CAMERA_WIFI_STREAM_WIFI_PASSWORD
    string "WiFi password"
    default ""

config CAMERA_WIFI_STREAM_MAXIMUM_RETRY
    int "Maximum WiFi retry count"
    range 0 20
    default 5

config CAMERA_WIFI_STREAM_ENABLE_WIFI_PS
    bool "Enable WiFi power save while streaming"
    default n
    help
        Keep station power save enabled. The stream example disables it by default
        to reduce latency jitter on the ESP32-C6 hosted WiFi link.

config CAMERA_WIFI_STREAM_JPEG_QUALITY
    int "JPEG quality"
    range 1 100
    default 88

config CAMERA_WIFI_STREAM_MAX_STREAM_FPS
    int "Maximum MJPEG stream FPS (0 disables limit)"
    range 0 30
    default 12
    help
        Limit frames sent to the browser while still draining the camera driver.
        This lowers hosted WiFi bandwidth pressure and reduces visible stutter.

config CAMERA_WIFI_STREAM_VIDEO_BUFFER_COUNT
    int "Video capture buffer count"
    range 2 6
    default 4
    help
        More buffers absorb short JPEG encode or TCP send stalls. Higher values use
        more PSRAM.

choice CAMERA_WIFI_STREAM_SENSOR
    prompt "Camera sensor"
    default CAMERA_WIFI_STREAM_SENSOR_OV2710

    config CAMERA_WIFI_STREAM_SENSOR_OV2710
        bool "OV2710"
        select CAMERA_OV2710
        select CAMERA_OV2710_MIPI_RAW10_1280X720_25FPS

    config CAMERA_WIFI_STREAM_SENSOR_SC2336
        bool "SC2336"
        select CAMERA_SC2336
        select CAMERA_SC2336_MIPI_RAW8_1280X720_30FPS

    config CAMERA_WIFI_STREAM_SENSOR_OV5645
        bool "OV5645"
        select CAMERA_OV5645
        select CAMERA_OV5645_MIPI_YUV422_1280X960_30FPS
endchoice

config CAMERA_WIFI_STREAM_I2C_PORT
    int "I2C/SCCB port"
    range 0 2
    default 0

config CAMERA_WIFI_STREAM_I2C_SDA
    int "I2C/SCCB SDA GPIO"
    range 0 54
    default 7

config CAMERA_WIFI_STREAM_I2C_SCL
    int "I2C/SCCB SCL GPIO"
    range 0 54
    default 8

config CAMERA_WIFI_STREAM_I2C_FREQ_HZ
    int "I2C/SCCB clock frequency (Hz)"
    range 10000 400000
    default 100000

config CAMERA_WIFI_STREAM_ENABLE_CAMERA_POWER
    bool "Enable camera power through SGM38121 on boot"
    default y

config CAMERA_WIFI_STREAM_DVDD1_MV
    int "SGM38121 DVDD1 target voltage (mV, 0 disables)"
    depends on CAMERA_WIFI_STREAM_ENABLE_CAMERA_POWER
    range 0 1504
    default 0
    help
        Set to 0 to keep DVDD1 disabled. Non-zero values are rounded to the
        SGM38121 DVDD range of 528-1504 mV in 8 mV steps.

config CAMERA_WIFI_STREAM_DVDD2_MV
    int "SGM38121 DVDD2 target voltage (mV, 0 disables)"
    depends on CAMERA_WIFI_STREAM_ENABLE_CAMERA_POWER
    range 0 1504
    default 0
    help
        Set to 0 to keep DVDD2 disabled. Non-zero values are rounded to the
        SGM38121 DVDD range of 528-1504 mV in 8 mV steps.

config CAMERA_WIFI_STREAM_AVDD1_MV
    int "SGM38121 AVDD1 target voltage (mV)"
    depends on CAMERA_WIFI_STREAM_ENABLE_CAMERA_POWER
    range 1504 3424
    default 1800

config CAMERA_WIFI_STREAM_AVDD2_MV
    int "SGM38121 AVDD2 target voltage (mV)"
    depends on CAMERA_WIFI_STREAM_ENABLE_CAMERA_POWER
    range 1504 3424
    default 2800

config CAMERA_WIFI_STREAM_RESET_GPIO
    int "Camera RESET GPIO (-1 to disable)"
    range -1 54
    default -1

config CAMERA_WIFI_STREAM_PWDN_GPIO
    int "Camera PWDN GPIO (-1 to disable)"
    range -1 54
    default -1

config CAMERA_WIFI_STREAM_XCLK_GPIO
    int "Camera XCLK GPIO (-1 to disable)"
    range -1 54
    default -1

config CAMERA_WIFI_STREAM_XCLK_FREQ_HZ
    int "Camera XCLK frequency (Hz)"
    range 1000000 40000000
    default 24000000
    help
        Ignored when XCLK GPIO is set to -1.

endmenu
